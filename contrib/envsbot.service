[Unit]
Description=EnvsBot XMPP bot
Documentation=https://github.com/envs-net/envsbot
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=envsbot
Group=envsbot
WorkingDirectory=/srv/envsbot
Environment=PYTHONUNBUFFERED=1
Environment=ENVSBOT_CONFIG=/etc/envsbot/config.py
EnvironmentFile=-/etc/default/envsbot
ExecStart=/srv/envsbot/.venv/bin/envsbot
Restart=on-failure
RestartSec=5
WatchdogSec=60
TimeoutStopSec=45
UMask=0077

# Keep application code read-only. Recommended deployments keep mutable state
# below /var/lib/envsbot and the runtime-editable config below /etc/envsbot.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/etc/envsbot /var/lib/envsbot

[Install]
WantedBy=multi-user.target
